---
const stats = [
  { n: '5',    label: 'Organizaciones miembro',            c: 'var(--c-sur)' },
  { n: '5',    label: 'Comunidades y ciudades autónomas',  c: 'var(--c-magec)' },
  { n: '3',    label: 'Proyectos europeos concedidos',     c: 'var(--c-murcia)' },
  { n: '2024', label: 'Año de fundación',                  c: 'var(--c-blue)' },
];
---

<div class="stats-bar">
  <div class="container">
    <dl class="stats-inner">
      {stats.map((s, i) => (
        <div class={`stat-item fade-in fade-in-delay-${i + 1}`} style={`--c:${s.c}`}>
          <dt class="stat-l">{s.label}</dt>
          <dd class="stat-n">{s.n}</dd>
        </div>
      ))}
    </dl>
  </div>
</div>

<style>
.stats-bar {
  background: var(--parchment);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  padding: 2.5rem 0;
}
.stats-inner {
  display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
}
.stat-item {
  display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: .5rem;
  padding: .35rem 1.75rem;
  border-left: 1px solid var(--line);
}
.stat-item:first-child { border-left: 0; padding-left: 0; }
.stat-n {
  position: relative;
  font-family: var(--font-serif);
  font-size: clamp(2.25rem, 4vw, 3rem); font-weight: 600; color: var(--ink);
  line-height: 1; letter-spacing: -.02em;
  font-variant-numeric: lining-nums tabular-nums;
  padding-top: .9rem;
}
.stat-n::before {
  content: ''; position: absolute; top: 0; left: 0;
  width: 24px; height: 3px; border-radius: 2px; background: var(--c);
}
.stat-l {
  font-size: .86rem; font-weight: 500; color: var(--ink-soft); line-height: 1.4;
  max-width: 18ch;
}
@media (max-width: 760px) {
  .stats-bar { padding: 1.75rem 0; }
  .stats-inner { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.75rem; }
  .stat-item { padding: .25rem 1.25rem; }
  .stat-item:nth-child(odd) { border-left: 0; padding-left: 0; }
}
</style>
