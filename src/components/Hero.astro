---
import { PIECES, STAR_CENTER } from '../lib/star.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Caja de la ilustración (unidades del viewBox de la estrella, 557 x 510)
const VB = { x: -125, y: -72, w: 850, h: 640 };

// Las cinco entidades orbitan alrededor de la estrella, cada una junto a la pieza
// de su color: azul Estrellas del Sur, amarillo Magec, morado Murcia Debate,
// verde Rif y rojo Horizonte Rioja. Datos (nombre, lugar y web) de organizaciones.astro.
const ORBIT = { cx: 285, cy: 258, r: 318 };
const members = [
  { id: 'eds', name: 'Estrellas del Sur', place: 'Córdoba',  c: 'var(--c-sur)',    deg: -130, side: 'l', web: 'https://estrellasdelsur.eu' },
  { id: 'hri', name: 'Horizonte Rioja',   place: 'La Rioja', c: 'var(--c-rioja)',  deg: -82,  side: 'r', web: 'https://www.horizonterioja.eu' },
  { id: 'ema', name: 'Estrella Magec',    place: 'Canarias', c: 'var(--c-magec)',  deg: -36,  side: 'r' },
  { id: 'mur', name: 'Murcia Debate',     place: 'Murcia',   c: 'var(--c-murcia)', deg: 38,   side: 'r' },
  { id: 'edr', name: 'Estrella del Rif',  place: 'Melilla',  c: 'var(--c-rif)',    deg: 163,  side: 'l', web: 'https://estrelladelrif.eu' },
].map((m, i) => {
  const rad = (m.deg * Math.PI) / 180;
  return { ...m, i, x: +(ORBIT.cx + ORBIT.r * Math.cos(rad)).toFixed(1), y: +(ORBIT.cy + ORBIT.r * Math.sin(rad)).toFixed(1) };
});

const pieces = PIECES.map((p, i) => {
  const vx = p.cx - STAR_CENTER.x;
  const vy = p.cy - STAR_CENTER.y;
  const len = Math.hypot(vx, vy) || 1;
  const ux = vx / len, uy = vy / len;
  return {
    ...p,
    i,
    // Desplazamiento de entrada
    dx: (ux * 70).toFixed(1), dy: (uy * 70).toFixed(1),
    rot: (i % 2 ? 9 : -9),
  };
});

const pct = (x: number, y: number) =>
  `left:${(((x - VB.x) / VB.w) * 100).toFixed(2)}%;top:${(((y - VB.y) / VB.h) * 100).toFixed(2)}%`;

const pills = [
  { name: 'Estrellas del Sur', place: 'Córdoba',  c: 'var(--c-sur)',    web: 'https://estrellasdelsur.eu' },
  { name: 'Estrella Magec',    place: 'Canarias', c: 'var(--c-magec)' },
  { name: 'Murcia Debate',     place: 'Murcia',   c: 'var(--c-murcia)' },
  { name: 'Estrella del Rif',  place: 'Melilla',  c: 'var(--c-rif)',    web: 'https://estrelladelrif.eu' },
  { name: 'Horizonte Rioja',   place: 'La Rioja', c: 'var(--c-rioja)',  web: 'https://www.horizonterioja.eu' },
];
---

<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-text">
      <a href={`${base}/actualidad/subvencion-ka153-concedida/`} class="hero-announcement">
        <span class="announcement-tag">Novedad</span>
        Subvención Erasmus+ KA153 concedida
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>

      <div class="hero-kicker">
        <span class="kicker-band" aria-hidden="true"></span>
        <span class="kicker-label">Federación · Erasmus+ · España</span>
      </div>

      <h1>
        Juntos llegamos
        <em>más lejos</em>
      </h1>

      <p class="hero-lead">
        Estrellas de Europa une asociaciones juveniles de distintas regiones de España
        para impulsar proyectos europeos con mayor alcance e impacto.
      </p>

      <div class="hero-actions">
        <a href={`${base}/organizaciones/`} class="btn btn-primary btn-lg">
          Nuestras organizaciones
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href={`${base}/sobre-nosotros/`} class="btn btn-outline-ink btn-lg">
          Conocer la federación
        </a>
      </div>

      <div class="hero-orgs">
        <span class="hero-orgs-label">Organizaciones miembro</span>
        <ul class="hero-org-pills">
          {pills.map((o) => (
            <li class="org-pill" style={`--c:${o.c}`}>
              {o.web
                ? <a href={o.web} target="_blank" rel="noopener" class="org-pill-in">
                    <span class="org-pill-dot" aria-hidden="true"></span>
                    {o.name}<span class="org-pill-place"> · {o.place}</span>
                    <svg class="org-pill-ext" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
                    <span class="sr-only">(web, se abre en otra pestaña)</span>
                  </a>
                : <span class="org-pill-in">
                    <span class="org-pill-dot" aria-hidden="true"></span>
                    {o.name}<span class="org-pill-place"> · {o.place}</span>
                  </span>}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="hero-visual" style={`--vb-ratio:${VB.w} / ${VB.h}`}>
      <svg class="hv-svg" viewBox={`${VB.x} ${VB.y} ${VB.w} ${VB.h}`} aria-hidden="true" focusable="false">
        <!-- Órbitas -->
        <circle class="hv-orbit" cx="285" cy="258" r="318" />
        <circle class="hv-orbit hv-orbit-2" cx="285" cy="258" r="236" />
        <!-- Destellos -->
        <g class="hv-sparks">
          <path d="M-60 120 l4 -12 4 12 12 4 -12 4 -4 12 -4 -12 -12 -4z" />
          <path d="M640 330 l3 -9 3 9 9 3 -9 3 -3 9 -3 -9 -9 -3z" />
          <path d="M120 520 l3 -9 3 9 9 3 -9 3 -3 9 -3 -9 -9 -3z" />
          <circle cx="560" cy="-30" r="4" />
          <circle cx="-20" cy="420" r="3" />
          <circle cx="660" cy="520" r="3.5" />
          <circle cx="40" cy="-50" r="2.5" />
        </g>
        <!-- Las cinco piezas, con los colores del logo -->
        {pieces.map((p) => (
          <polygon
            class={`hv-piece sp-${p.id}`}
            points={p.pts}
            fill={p.c}
            style={`--i:${p.i};--dx:${p.dx}px;--dy:${p.dy}px;--rot:${p.rot}deg`}
          />
        ))}
        <!-- Una entidad en cada punto de la órbita -->
        {members.map((m) => (
          <g class={`hv-member hm-${m.id}`} style={`--c:${m.c};--i:${m.i}`}>
            <circle class="hv-halo" cx={m.x} cy={m.y} r="17" />
            <circle class="hv-dot" cx={m.x} cy={m.y} r="8.5" />
          </g>
        ))}
      </svg>

      {members.map((m) => (
        <a
          href={m.web ?? `${base}/organizaciones/#${m.id}`}
          {...(m.web ? { target: '_blank', rel: 'noopener' } : {})}
          class={`hv-label hv-label-${m.side} hl-${m.id}`}
          style={`${pct(m.x, m.y)};--c:${m.c};--i:${m.i}`}
        >
          <strong>{m.name}</strong>
          <span>{m.place}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
.hero {
  position: relative; overflow: hidden; isolation: isolate;
  min-height: min(100vh, 920px);
  display: flex; align-items: center;
  padding: calc(var(--nav-offset) + 3.25rem) 0 4.5rem;
  background: var(--parchment);
}
.hero-bg {
  position: absolute; inset: 0; z-index: -1; pointer-events: none;
  background:
    radial-gradient(circle at 73% 46%, rgba(217,167,39,.14) 0, rgba(217,167,39,.05) 22%, transparent 42%),
    linear-gradient(180deg, #fff 0%, #fff 55%, var(--sand) 100%);
}
.hero-bg::before {
  content: ''; position: absolute; inset: 0;
  background-image: radial-gradient(rgba(20,28,46,.09) 1px, transparent 1.3px);
  background-size: 26px 26px;
  -webkit-mask-image: radial-gradient(ellipse 70% 80% at 70% 45%, #000 0%, transparent 75%);
          mask-image: radial-gradient(ellipse 70% 80% at 70% 45%, #000 0%, transparent 75%);
}

.hero-inner {
  width: 100%;
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: clamp(2rem, 4vw, 4rem); align-items: center;
}
.hero-text { max-width: 620px; }

.hero-announcement {
  display: inline-flex; align-items: center; gap: .6rem;
  background: var(--parchment); border: 1px solid var(--line);
  border-radius: var(--radius-full);
  padding: .3rem .95rem .3rem .3rem;
  font-size: .84rem; font-weight: 500; color: var(--ink-soft);
  text-decoration: none; margin-bottom: 1.75rem;
  box-shadow: 0 1px 2px rgba(20,30,50,.05);
  transition: border-color .2s, box-shadow .2s, color .2s;
}
.hero-announcement:hover { border-color: var(--sand-deeper); color: var(--ink); box-shadow: var(--shadow-card); }
.hero-announcement svg { transition: transform .25s var(--ease-out); }
.hero-announcement:hover svg { transform: translateX(3px); }
.announcement-tag {
  font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  background: var(--ink); color: #fff;
  padding: .22rem .6rem; border-radius: var(--radius-full);
}

.hero-kicker { display: flex; align-items: center; gap: .75rem; margin-bottom: 1.25rem; }
.kicker-band { width: 44px; height: 4px; border-radius: 2px; background: var(--fed-band); }
.kicker-label {
  font-size: .76rem; font-weight: 700; letter-spacing: .16em;
  text-transform: uppercase; color: var(--ink-mute);
}

.hero-text h1 {
  font-size: var(--fs-display);
  color: var(--ink); margin-bottom: 1.4rem; line-height: 1.04;
  letter-spacing: -.025em;
}
.hero-text h1 em {
  display: block; font-style: italic; font-weight: 500;
  color: var(--accent);
}

.hero-lead {
  font-size: clamp(1.05rem, 1.6vw, 1.2rem);
  color: var(--ink-soft); line-height: 1.7;
  margin-bottom: 2.25rem; max-width: 34em;
}

.hero-actions { display: flex; gap: .75rem; flex-wrap: wrap; margin-bottom: 3rem; }
.hero-actions .btn-lg { padding-inline: 1.6rem; }

.hero-orgs { border-top: 1px solid var(--line); padding-top: 1.5rem; }
.hero-orgs-label {
  font-size: .72rem; font-weight: 700; letter-spacing: .14em;
  text-transform: uppercase; color: var(--ink-mute);
  display: block; margin-bottom: .85rem;
}
.hero-org-pills { display: flex; flex-wrap: wrap; gap: .45rem; }
.org-pill {
  display: inline-flex;
  font-size: .8rem; font-weight: 600; color: var(--ink);
  border-radius: var(--radius-full);
  background: var(--parchment);
  border: 1px solid var(--line);
  transition: border-color .2s, box-shadow .2s;
}
.org-pill-in {
  display: inline-flex; align-items: center; gap: .45rem;
  padding: .32rem .8rem .32rem .65rem;
  color: inherit; text-decoration: none; border-radius: inherit;
}
.org-pill:has(a):hover { border-color: var(--c); box-shadow: 0 2px 8px rgba(20,30,50,.08); }
.org-pill-ext { color: var(--ink-mute); margin-left: -.1rem; }
.org-pill-dot {
  width: 9px; height: 9px; flex-shrink: 0; background: var(--c);
  clip-path: polygon(0 100%, 100% 0, 62% 100%);
}
.org-pill-place { font-weight: 400; color: var(--ink-mute); }

/* ── Constelación ─────────────────────────────────── */
.hero-visual {
  position: relative; width: 100%; max-width: 620px; justify-self: end;
  aspect-ratio: var(--vb-ratio);
}
.hv-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.hv-orbit { fill: none; stroke: rgba(20,28,46,.12); stroke-width: 1.5; stroke-dasharray: 2 9; stroke-linecap: round; }
.hv-orbit-2 { stroke: rgba(20,28,46,.07); stroke-dasharray: none; }
.hv-sparks { fill: var(--c-magec); opacity: .75; }
.hv-sparks circle { fill: var(--ink); opacity: .25; }

.hv-piece {
  transform-box: fill-box; transform-origin: center;
  animation: piece-in 1.3s var(--ease-out) backwards;
  animation-delay: calc(var(--i) * 110ms + 150ms);
  filter: drop-shadow(0 10px 18px rgba(20,28,46,.12));
}
@keyframes piece-in {
  from { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(var(--rot)) scale(.9); }
}

.hv-member { animation: label-in .6s var(--ease-out) backwards; animation-delay: calc(var(--i) * 90ms + 1s); }
.hv-halo { fill: var(--c); opacity: .14; transform-box: fill-box; transform-origin: center; transition: transform .3s var(--ease-out), opacity .3s; }
.hv-dot { fill: var(--c); stroke: var(--parchment); stroke-width: 3.5; }

.hv-label {
  position: absolute; display: flex; flex-direction: column; line-height: 1.25;
  text-decoration: none; white-space: nowrap;
  padding: .3rem .55rem; border-radius: 8px;
  transition: background-color .2s, box-shadow .2s;
  animation: label-in .6s var(--ease-out) backwards;
  animation-delay: calc(var(--i) * 90ms + 1.2s);
}
.hv-label-r { transform: translate(10px, -50%); }
.hv-label-l { transform: translate(calc(-100% - 10px), -50%); text-align: right; }
.hv-label strong { font-size: .86rem; font-weight: 700; color: var(--ink); }
.hv-label span { font-size: .76rem; color: var(--ink-mute); }
.hv-label:hover, .hv-label:focus-visible { background: var(--parchment); box-shadow: var(--shadow-card); }
.hv-label:hover strong { color: var(--c); }
@keyframes label-in { from { opacity: 0; } }

/* Realce del marcador al señalar su entidad */
.hero-visual:has(.hl-eds:hover, .hl-eds:focus-visible) .hm-eds .hv-halo,
.hero-visual:has(.hl-ema:hover, .hl-ema:focus-visible) .hm-ema .hv-halo,
.hero-visual:has(.hl-mur:hover, .hl-mur:focus-visible) .hm-mur .hv-halo,
.hero-visual:has(.hl-hri:hover, .hl-hri:focus-visible) .hm-hri .hv-halo,
.hero-visual:has(.hl-edr:hover, .hl-edr:focus-visible) .hm-edr .hv-halo {
  transform: scale(1.6); opacity: .22;
}

@media (max-width: 1024px) {
  .hero { min-height: auto; padding: calc(var(--nav-offset) + 2.75rem) 0 3.5rem; }
  .hero-inner { grid-template-columns: 1fr; gap: 1rem; }
  .hero-text { max-width: 680px; }
  .hero-visual { justify-self: center; max-width: 560px; margin-right: 0; }
}
@media (max-width: 640px) {
  .hero { padding: calc(var(--nav-offset) + 2rem) 0 2.5rem; }
  .hero-text h1 { letter-spacing: -.02em; }
  .hero-actions { flex-direction: column; align-items: stretch; margin-bottom: 2.25rem; }
  .hero-actions .btn { width: 100%; }
  .hero-visual { max-width: 300px; margin-top: .25rem; }
  .hero-announcement { font-size: .8rem; }
  .hero-org-pills { gap: .4rem; }
  .hv-label { display: none; }
  .hv-orbit { stroke-width: 2.5; }
}
</style>
