---
interface Props {
  /** Solo las tarjetas, sin sección ni encabezado (para incrustar en otra página) */
  bare?: boolean;
}
const { bare = false } = Astro.props;
const Tag = bare ? 'div' : 'section';

const members = [
  { name: 'Maximiliano Moreno López', role: 'Presidencia', org: 'Estrellas del Sur', color: 'var(--c-sur)',    text: 'var(--c-sur)', initials: 'MM' },
  { name: 'Pablo Sánchez Ruiz',       role: 'Secretaría',  org: 'Estrella Magec',    color: 'var(--c-magec)',  text: 'var(--c-magec-ink)', initials: 'PS', darkText: true },
  { name: 'Nacho Fenollar',           role: 'Vocalía',     org: 'Murcia Debate',     color: 'var(--c-murcia)', text: 'var(--c-murcia)',    initials: 'NF' },
];
---

<Tag class:list={['organigrama', { 'section-sm organigrama-section': !bare }]} id={bare ? undefined : 'equipo'}>
  <div class:list={[{ container: !bare }]}>
    {!bare && (
      <div class="org-header fade-in">
        <span class="section-label" style="--label-c: var(--c-rioja)">Junta Directiva</span>
        <h2 class="section-title">Equipo de la federación</h2>
        <p class="section-subtitle">
          Representantes de las organizaciones miembro que gobiernan la federación
          con una visión plural e integrada.
        </p>
      </div>
    )}

    <div class="team fade-in fade-in-delay-1">
      <div class="team-rail" aria-hidden="true"><span></span></div>
      <ul class="team-cards">
        {members.map((m) => (
          <li class="team-card" style={`--c: ${m.color}; --c-text: ${m.text}`}>
            <div class={`team-avatar ${m.darkText ? 'team-avatar-dark' : ''}`} aria-hidden="true">
              {m.initials}
            </div>
            <div class="team-info">
              <span class="team-role">{m.role}</span>
              <strong class="team-name">{m.name}</strong>
              <span class="team-org"><span class="team-piece" aria-hidden="true"></span>{m.org}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Tag>

<style>
.organigrama-section { background: var(--sand); }
.org-header { max-width: 640px; margin-bottom: 2.5rem; }

.team { position: relative; }
.team-rail {
  position: relative; height: 1px; background: var(--sand-deeper);
  margin: 0 calc((100% - 3rem) / 6); top: 0;
}
.team-rail span {
  position: absolute; left: 50%; top: 50%; width: 48px; height: 4px; border-radius: 2px;
  transform: translate(-50%, -50%); background: var(--fed-band);
}
.team-cards {
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem; padding-top: 1.75rem; position: relative;
}
.team-card {
  position: relative;
  display: flex; align-items: center; gap: 1rem;
  background: var(--parchment);
  border-radius: var(--radius-lg);
  border: 1px solid rgba(20,30,50,.08);
  padding: 1.25rem 1.4rem;
  box-shadow: var(--shadow-card);
}
.team-card::before {
  content: ''; position: absolute; left: 50%; top: calc(-1.75rem - 1px); width: 1px; height: 1.75rem;
  background: var(--sand-deeper);
}
.team-avatar {
  position: relative;
  width: 52px; height: 52px; border-radius: 50%; flex-shrink: 0;
  background: var(--c); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-serif); font-weight: 600; font-size: 1.05rem; letter-spacing: .02em;
}
.team-avatar-dark { color: var(--ink); }
.team-piece { width: 10px; height: 10px; flex-shrink: 0; background: var(--c); clip-path: polygon(0 100%, 100% 0, 62% 100%); }
.team-info { display: flex; flex-direction: column; gap: .1rem; min-width: 0; }
.team-role {
  font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  color: var(--ink-mute);
}
.team-name { font-size: 1rem; font-weight: 600; color: var(--ink); line-height: 1.3; }
.team-org { display: inline-flex; align-items: center; gap: .4rem; font-size: .84rem; font-weight: 500; color: var(--c-text); }

@media (max-width: 860px) {
  .team-rail, .team-card::before { display: none; }
  .team-cards { grid-template-columns: 1fr; gap: 1rem; padding-top: 0; max-width: 520px; }
}
</style>
