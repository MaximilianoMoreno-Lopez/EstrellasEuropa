---
const ICON = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"';
const pillars = [
  {
    icon: `<svg ${ICON}><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z"/></svg>`,
    title: 'Movilidad europea',
    desc: 'Facilitamos intercambios, voluntariados y formaciones en el marco del programa Erasmus+ para jóvenes de toda España.',
    color: 'var(--c-sur)',
  },
  {
    icon: `<svg ${ICON}><path d="M4 5a2 2 0 0 1 2-2h6v16H6a2 2 0 0 0-2 2z"/><path d="M20 5a2 2 0 0 0-2-2h-6v16h6a2 2 0 0 1 2 2z"/></svg>`,
    title: 'Aprendizaje no formal',
    desc: 'Creemos en el poder de la educación fuera del aula: dinámicas grupales, trabajo por proyectos y experiencias transformadoras.',
    color: 'var(--c-magec)', ink: 'var(--c-magec-ink)',
  },
  {
    icon: `<svg ${ICON}><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1L12 21.5l8.8-8.8a5 5 0 0 0 0-7.1z"/></svg>`,
    title: 'Valores europeos',
    desc: 'Promovemos la ciudadanía activa, la inclusión y la diversidad como pilares de una Europa unida.',
    color: 'var(--c-blue)',
  },
];
---

<section class="section mision-section">
  <div class="container">
    <div class="mision-grid">
      <div class="mision-text fade-in">
        <span class="section-label" style="--label-c: var(--c-sur)">Nuestra misión</span>
        <h2 class="section-title">Impulsamos oportunidades para la juventud española en Europa</h2>
        <div class="divider"></div>
        <p class="section-subtitle">
          Estrellas de Europa nació en 2024 para aunar fuerzas entre asociaciones juveniles
          de distintas regiones y ampliar el alcance de los proyectos europeos.
        </p>
        <p class="section-subtitle" style="margin-top:1rem">
          Acceso conjunto a financiación Erasmus+, metodologías compartidas y mayor
          calidad en cada proyecto.
        </p>
      </div>

      <div class="pillars fade-in fade-in-delay-1">
        {pillars.map((p, i) => (
          <div class="pillar" style={`--pc: ${p.color}; --pc-ink: ${p.ink ?? p.color}`}>
            <span class="pillar-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="pillar-icon" set:html={p.icon} />
            <div>
              <h4 class="pillar-title">{p.title}</h4>
              <p class="pillar-desc">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.mision-section { background: var(--parchment); }
.mision-grid {
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: clamp(2.5rem, 6vw, 5.5rem); align-items: center;
}
.mision-text .section-title { max-width: 22ch; }
.pillars { display: flex; flex-direction: column; counter-reset: p; }
.pillar {
  position: relative;
  display: grid; grid-template-columns: auto 44px minmax(0, 1fr); align-items: start; gap: 1.1rem;
  padding: 1.6rem 0;
  border-top: 1px solid var(--line);
}
.pillar:last-child { border-bottom: 1px solid var(--line); }
.pillar::before {
  content: ''; position: absolute; left: 0; top: -1px; width: 48px; height: 2px;
  background: var(--pc);
}
.pillar-num {
  font-family: var(--font-serif); font-size: .95rem; font-weight: 600;
  color: var(--ink-mute); font-variant-numeric: lining-nums tabular-nums;
  padding-top: .6rem; min-width: 1.6rem;
}
.pillar-icon {
  width: 44px; height: 44px; flex-shrink: 0;
  border-radius: 12px; display: flex; align-items: center; justify-content: center;
  background: color-mix(in srgb, var(--pc) 13%, transparent); color: var(--pc-ink);
}
.pillar-icon :global(svg) { width: 22px; height: 22px; flex-shrink: 0; }
.pillar-title {
  font-size: 1.0625rem; font-weight: 600; color: var(--ink);
  margin-bottom: .3rem; font-family: var(--font-sans); letter-spacing: 0;
}
.pillar-desc { font-size: .92rem; color: var(--ink-soft); line-height: 1.65; }

@media (max-width: 860px) { .mision-grid { grid-template-columns: 1fr; gap: 2.5rem; } }
@media (max-width: 480px) {
  .pillar { grid-template-columns: 44px minmax(0, 1fr); }
  .pillar-num { display: none; }
}
</style>
