---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();

const members = [
  { name: 'Estrellas del Sur', url: 'https://estrellasdelsur.eu',  c: 'var(--c-sur-light)' },
  { name: 'Estrella Magec',    url: null,                          c: 'var(--c-magec-light)' },
  { name: 'Murcia Debate',     url: null,                          c: 'var(--c-murcia-light)' },
  { name: 'Estrella del Rif',  url: 'https://estrelladelrif.eu',   c: 'var(--c-blue-light)' },
  { name: 'Horizonte Rioja',   url: 'https://www.horizonterioja.eu', c: 'var(--c-rioja-light)' },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">

      <div class="footer-brand">
        <a href={`${base}/`} class="footer-logo">
          <span class="footer-logo-tile"><img src={`${base}/logo-star.png`} alt="" width="34" height="31" /></span>
          <span class="footer-logo-text">
            <span>Estrellas de Europa</span>
            <small>Federación</small>
          </span>
        </a>
        <p class="footer-desc">
          Federación que agrupa asociaciones juveniles comprometidas con la movilidad europea
          y el aprendizaje no formal.
        </p>
        <p class="footer-nif">NIF: G75822320</p>
      </div>

      <div class="footer-col">
        <h2 class="footer-h">Federación</h2>
        <ul>
          <li><a href={`${base}/sobre-nosotros/`}>Sobre nosotros</a></li>
          <li><a href={`${base}/organizaciones/`}>Organizaciones miembro</a></li>
          <li><a href={`${base}/proyectos/`}>Proyectos</a></li>
          <li><a href={`${base}/actualidad/`}>Actualidad</a></li>
          <li><a href={`${base}/transparencia/`}>Transparencia</a></li>
          <li><a href={`${base}/unete/`}>Únete</a></li>
          <li><a href={`${base}/contacto/`}>Contacto</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h2 class="footer-h">Miembros</h2>
        <ul class="footer-members">
          {members.map((m) => (
            <li style={`--c:${m.c}`}>
              <span class="fm-dot" aria-hidden="true"></span>
              {m.url
                ? <a href={m.url} target="_blank" rel="noopener">{m.name}<span class="sr-only"> (se abre en otra pestaña)</span></a>
                : <span>{m.name}</span>}
            </li>
          ))}
        </ul>
      </div>

      <div class="footer-col footer-contact">
        <h2 class="footer-h">Contacto</h2>
        <ul>
          <li><a href="mailto:admin@estrellaseuropa.eu">admin@estrellaseuropa.eu</a></li>
          <li class="footer-addr">San Valeriano 6, 4A<br />28039 Madrid</li>
        </ul>
      </div>

    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Federación Estrellas de Europa. Todos los derechos reservados.</p>
      <span class="footer-legal">
        <a href={`${base}/transparencia/`}>Transparencia</a>
        <span aria-hidden="true">·</span>
        <a href={`${base}/privacidad/`}>Privacidad</a>
        <span aria-hidden="true">·</span>
        <a href={`${base}/terminos/`}>Términos</a>
      </span>
    </div>
  </div>
</footer>

<style>
.footer {
  --foot-text: rgba(var(--on-dark), .72);
  --foot-mute: rgba(var(--on-dark), .6);
  --foot-head: rgba(var(--on-dark), .62);
  position: relative;
  background: var(--night-0);
  color: var(--foot-text);
  padding: 4.5rem 0 2rem;
}
.footer::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: var(--fed-band);
}
.footer-grid {
  display: grid; grid-template-columns: 1.8fr 1fr 1fr 1.3fr;
  gap: 3rem; padding-bottom: 3rem;
  border-bottom: 1px solid rgba(var(--on-dark), .1);
}
.footer-logo {
  display: inline-flex; align-items: center; gap: .8rem;
  text-decoration: none; color: #fff; margin-bottom: 1.25rem; border-radius: 10px;
}
.footer-logo-tile {
  width: 46px; height: 46px; border-radius: 12px; background: #fff;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.footer-logo-tile img { width: 32px; height: auto; }
.footer-logo-text { display: flex; flex-direction: column; line-height: 1.15; }
.footer-logo-text span {
  font-family: var(--font-serif); font-size: 1.1rem; font-weight: 700;
}
.footer-logo-text small {
  font-size: .66rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
  color: var(--foot-mute);
}
.footer-desc { font-size: .9rem; line-height: 1.7; color: var(--foot-text); margin-bottom: .75rem; max-width: 36ch; }
.footer-nif  { font-size: .8rem; color: var(--foot-mute); font-variant-numeric: tabular-nums; }
.footer-h {
  font-family: var(--font-sans); font-size: .74rem; font-weight: 700;
  letter-spacing: .14em; text-transform: uppercase;
  color: var(--foot-head); margin-bottom: 1.1rem;
}
.footer-col ul { display: flex; flex-direction: column; gap: .2rem; }
.footer-col li { font-size: .9rem; color: var(--foot-text); }
.footer-col a {
  display: inline-block; padding: .25rem 0;
  font-size: .9rem; color: rgba(var(--on-dark), .82);
  text-decoration: none; transition: color .2s;
  overflow-wrap: anywhere;
}
.footer-col a:hover { color: var(--eu-gold); text-decoration: underline; text-underline-offset: 3px; }
.footer-members li { display: flex; align-items: center; gap: .55rem; }
.footer-members li > span:not(.fm-dot) { padding: .25rem 0; }
.fm-dot {
  width: 9px; height: 9px; flex-shrink: 0; background: var(--c);
  clip-path: polygon(0 100%, 100% 0, 62% 100%);
}
.footer-addr { font-size: .88rem !important; line-height: 1.6; padding-top: .35rem; }
.footer-bottom {
  display: flex; align-items: center; justify-content: space-between;
  padding-top: 1.5rem; gap: 1rem; flex-wrap: wrap;
}
.footer-bottom p { font-size: .8rem; color: var(--foot-mute); }
.footer-legal { display: inline-flex; align-items: center; gap: .6rem; font-size: .8rem; color: var(--foot-mute); }
.footer-legal a { color: rgba(var(--on-dark), .78); text-decoration: none; transition: color .2s; padding: .25rem 0; }
.footer-legal a:hover { color: var(--eu-gold); }

@media (max-width: 960px) { .footer-grid { grid-template-columns: 1fr 1fr; gap: 2.5rem; } }
@media (max-width: 560px) {
  .footer { padding-top: 3.5rem; }
  .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem 1.25rem; }
  .footer-brand, .footer-contact { grid-column: 1 / -1; }
  .footer-bottom { flex-direction: column; align-items: flex-start; }
}
</style>
