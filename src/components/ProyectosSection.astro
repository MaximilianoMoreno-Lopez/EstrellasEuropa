---
const ICON = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const proyectos = [
  {
    id: 'frames',
    badge: 'Erasmus+ KA152',
    badgeColor: '#6b3a8a',
    title: 'Frames of Us',
    org: 'Intercambio juvenil · Madrid',
    status: 'En preparación',
    statusColor: '#8a6410',
    description: 'Intercambio juvenil de ocho días en Madrid coordinado por la federación, con cinco organizaciones de Chequia, Portugal, Chipre, Polonia y Grecia. Treinta jóvenes trabajan la relación entre bienestar, identidad y participación a través de la narración, y cierran con un Día Comunitario abierto al barrio de Usera.',
    tags: ['Intercambio juvenil', 'Bienestar', 'Narración', 'Madrid'],
    icon: `<svg ${ICON}><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>`,
    highlight: false,
    href: `${base}/proyectos/frames-of-us/`,
    hrefLabel: 'Ver la ficha del proyecto',
  },
  {
    id: 'decide',
    badge: 'Cuerpo Europeo de Solidaridad',
    badgeColor: '#3d7848',
    title: 'Decide con Información',
    org: 'Proyecto de Solidaridad · Madrid',
    status: 'En ejecución',
    statusColor: '#3d7848',
    description: 'Cinco jóvenes que cursaron itinerarios internacionales de Bachillerato acompañan a estudiantes de institutos públicos madrileños en el momento de elegir su itinerario, para que Bachibac, Bachillerato Dual e IB dejen de depender de tener la información en casa.',
    tags: ['Inclusión y diversidad', 'Orientación académica', 'Comunidad de Madrid'],
    icon: `<svg ${ICON}><path d="M12 3 2 8l10 5 10-5-10-5Z"/><path d="M6 10.5V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-5.5"/><path d="M22 8v6"/></svg>`,
    highlight: true,
    href: `${base}/proyectos/decide-con-informacion/`,
    hrefLabel: 'Seguir el proyecto',
  },
  {
    id: 'nest',
    badge: 'Erasmus+ KA153',
    badgeColor: '#003399',
    title: 'NEST',
    org: 'Movilidad de trabajadores de juventud',
    status: 'Activo',
    statusColor: '#3d7848',
    description: 'Proyecto de movilidad Erasmus+ KA153 concedido a la federación: financia estancias formativas de nuestros educadores y técnicos de juventud en organizaciones de acogida europeas, y el trabajo en red con entidades de varios países.',
    tags: ['Movilidad internacional', 'Formación', 'Educación no formal'],
    icon: `<svg ${ICON}><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>`,
    highlight: false,
    href: `${base}/actualidad/nest-cooperacion-europea/`,
    hrefLabel: 'Leer en actualidad',
  },
];
---

<section class="section proyectos-section" id="proyectos">
  <div class="container">
    <div class="proyectos-header fade-in">
      <span class="section-label" style="--label-c: var(--c-blue)">Proyectos activos</span>
      <h2 class="section-title">Lo que estamos construyendo</h2>
      <p class="section-subtitle">
        Proyectos con impacto real para jóvenes y educadores de toda España.
      </p>
    </div>

    <div class="proyectos-grid">
      {proyectos.map((p, i) => (
        <article class={`proyecto-card fade-in fade-in-delay-${i + 1}`} style={`--pc:${p.badgeColor}`}>
          <div class="proyecto-top">
            <span class="proyecto-icon" set:html={p.icon} />
            <span class="proyecto-status" style={`--sc: ${p.statusColor}`}>
              <span class="status-dot"></span>
              {p.status}
            </span>
          </div>

          <span class="proyecto-badge">{p.badge}</span>
          <h3 class="proyecto-title">{p.title}</h3>
          <p class="proyecto-org">{p.org}</p>
          <p class="proyecto-desc">{p.description}</p>

          <div class="proyecto-tags">
            {p.tags.map(t => <span class="proyecto-tag">{t}</span>)}
          </div>

          {p.href && (
            <a href={p.href} class="proyecto-link">
              {p.hrefLabel ?? 'Ver más'}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          )}
        </article>
      ))}
    </div>

    <div class="proyectos-more fade-in">
      <a href={`${base}/proyectos/`} class="link-arrow">
        Todos los proyectos
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
.proyectos-section { background: var(--sand); }
.proyectos-header { margin-bottom: var(--space-head); }
.proyectos-grid {
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem;
}

.proyecto-card {
  position: relative;
  background: var(--parchment);
  border-radius: var(--radius-lg);
  border: 1px solid rgba(20,30,50,.07);
  box-shadow: var(--shadow-card);
  padding: 1.75rem 1.75rem 1.6rem;
  display: flex; flex-direction: column; gap: .75rem;
  overflow: hidden;
}
.proyecto-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--pc);
}

.proyecto-top {
  display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  margin-bottom: .4rem;
}
.proyecto-icon {
  width: 48px; height: 48px; border-radius: 12px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  color: var(--pc); background: color-mix(in srgb, var(--pc) 11%, transparent);
}
.proyecto-icon :global(svg) { width: 24px; height: 24px; flex-shrink: 0; }

.proyecto-badge {
  align-self: flex-start;
  font-size: .7rem; font-weight: 700; letter-spacing: .08em;
  text-transform: uppercase; color: var(--pc);
}
.proyecto-status {
  display: inline-flex; align-items: center; gap: .4rem;
  font-size: .76rem; font-weight: 600; color: var(--sc);
  padding: .25rem .65rem; border-radius: var(--radius-full);
  background: color-mix(in srgb, var(--sc) 9%, transparent);
}
.status-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; background: var(--sc); }

.proyecto-title {
  font-size: var(--fs-h3); color: var(--ink); line-height: 1.25;
}
.proyecto-org {
  font-size: .76rem; font-weight: 600; color: var(--ink-mute);
  text-transform: uppercase; letter-spacing: .07em; margin-top: -.35rem;
}
.proyecto-desc {
  font-size: .9rem; color: var(--ink-soft); line-height: 1.68;
  flex: 1;
}
.proyecto-tags { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .25rem; }
.proyecto-tag {
  font-size: .72rem; font-weight: 500;
  padding: .2rem .65rem; border-radius: var(--radius-full);
  background: var(--sand); color: var(--ink-soft);
  border: 1px solid var(--sand-dark);
}

.proyecto-link {
  display: inline-flex; align-items: center; gap: .45rem; margin-top: .5rem;
  padding-top: 1rem; border-top: 1px solid var(--line);
  font-size: .9rem; font-weight: 600; text-decoration: none; color: var(--pc);
  transition: gap .2s var(--ease-out); min-height: 44px;
}
.proyecto-link:hover { gap: .7rem; }
.proyectos-more { margin-top: 2.25rem; text-align: center; }

@media (max-width: 1060px) {
  .proyectos-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .proyecto-card:first-child { grid-column: 1 / -1; }
}
@media (max-width: 720px) {
  .proyectos-grid { grid-template-columns: 1fr; }
  .proyecto-card { padding: 1.5rem 1.35rem; }
}
</style>
