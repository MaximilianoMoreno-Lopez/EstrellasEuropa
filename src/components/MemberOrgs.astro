---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const ICON = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"';
const orgs = [
  {
    id: 'EDS',
    name: 'Estrellas del Sur',
    location: 'Córdoba, Andalucía',
    color: '#c44e2a',
    flag: `<svg ${ICON}><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/></svg>`,
    description: 'Asociación juvenil cordobesa promotora de la movilidad Erasmus+ y el aprendizaje no formal. Sede fundadora de la federación.',
    tags: ['Intercambios juveniles', 'Voluntariado ESC', 'Formación'],
    website: 'https://estrellasdelsur.eu',
  },
  {
    id: 'EMA',
    name: 'Estrella Magec',
    location: 'Islas Canarias',
    color: '#d9a727',
    text: '#8a6410',
    flag: `<svg ${ICON}><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    description: 'Asociación canaria dedicada a la inclusión juvenil y la participación activa en proyectos europeos de educación no formal.',
    tags: ['Inclusión juvenil', 'Erasmus+', 'Educación no formal'],
    website: null,
  },
  {
    id: 'MUR',
    name: 'Murcia Debate',
    location: 'Murcia',
    color: '#6b3a8a',
    flag: `<svg ${ICON}><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0"/><line x1="12" y1="17" x2="12" y2="22"/></svg>`,
    description: 'Organización murciana que impulsa el pensamiento crítico y la participación juvenil a través del debate y proyectos europeos.',
    tags: ['Debate', 'Pensamiento crítico', 'Participación juvenil'],
    website: null,
  },
  {
    id: 'EDR',
    name: 'Estrella del Rif',
    location: 'Melilla',
    color: '#2b52a8',
    flag: `<svg ${ICON}><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>`,
    description: 'Asociación juvenil melillense que acerca las oportunidades europeas a la juventud de una región periférica, con un enfoque intercultural e inclusivo.',
    tags: ['Participación juvenil', 'Diálogo intercultural', 'Inclusión'],
    website: 'https://estrelladelrif.eu',
  },
  {
    id: 'HRI',
    name: 'Horizonte Rioja',
    location: 'La Rioja',
    color: '#5b1a33',
    flag: `<img src="${base}/orgs/horizonte-rioja.svg" alt="" width="260" height="168" />`,
    description: 'Asociación juvenil riojana creada por jóvenes de pueblo para que vivir en el medio rural no signifique tener menos oportunidades, en su territorio y en Europa.',
    tags: ['Juventud rural', 'Igualdad y diversidad', 'Erasmus+'],
    website: 'https://www.horizonterioja.eu',
  },
];

---

<section class="section member-orgs" id="organizaciones">
  <div class="container">
    <div class="orgs-header fade-in">
      <span class="section-label" style="--label-c: var(--c-murcia)">Nuestras organizaciones</span>
      <h2 class="section-title">Cinco asociaciones, un mismo compromiso</h2>
      <p class="section-subtitle">
        Entidades de distintas regiones de España que comparten la visión de una Europa
        más accesible y participativa para la juventud.
      </p>
    </div>

    <div class="orgs-grid">
      {orgs.map((org, i) => (
        <article class={`org-card fade-in fade-in-delay-${(i % 3) + 1}`} style={`--c: ${org.color}; --c-text: ${org.text ?? org.color}`}>
          <div class="org-top">
            <svg class="org-piece" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><polygon points="0,100 100,0 62,100" /></svg>
            <span class={`org-flag ${org.id === 'HRI' ? 'org-flag-logo' : ''}`} set:html={org.flag} />
            <span class="org-id">{org.id}</span>
          </div>
          <div class="org-body">
            <h3>{org.name}</h3>
            <p class="org-loc">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
              {org.location}
            </p>
            <p class="org-desc">{org.description}</p>
            <div class="org-tags">
              {org.tags.map(t => <span class="org-tag">{t}</span>)}
            </div>
          </div>
          <div class="org-foot">
            {org.website
              ? <a href={org.website} target="_blank" rel="noopener" class="org-link">
                  Visitar web
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
                  <span class="sr-only">(se abre en otra pestaña)</span>
                </a>
              : <span class="org-soon">Próximamente online</span>
            }
          </div>
        </article>
      ))}
    </div>

    <div class="orgs-cta fade-in">
      <a href={`${base}/organizaciones/`} class="btn btn-outline-ink">
        Ver todas las organizaciones
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
.member-orgs { background: var(--sand); }
.orgs-header { max-width: 640px; margin-bottom: var(--space-head); }
.orgs-grid {
  display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 1.5rem; margin-bottom: 2.75rem;
}
.org-card { grid-column: span 2; }
.org-card:nth-child(4) { grid-column: 2 / span 2; }
.org-card:nth-child(5) { grid-column: 4 / span 2; }
.org-card {
  background: var(--parchment);
  border-radius: var(--radius-lg);
  border: 1px solid rgba(20,30,50,.07);
  box-shadow: var(--shadow-card);
  overflow: hidden; display: flex; flex-direction: column;
}
.org-top {
  position: relative; overflow: hidden;
  height: 92px;
  background: color-mix(in srgb, var(--c) 9%, var(--parchment));
  border-bottom: 3px solid var(--c);
  padding: 0 1.4rem 1rem;
  display: flex; align-items: flex-end; justify-content: space-between;
}
.org-piece {
  position: absolute; right: 5.25rem; top: 14px; height: 64px; width: 70px;
  fill: var(--c); opacity: .2;
}
.org-flag {
  position: relative; display: flex; align-items: center; justify-content: center;
  width: 52px; height: 52px; border-radius: 14px;
  background: var(--parchment); color: var(--c-text);
  box-shadow: 0 1px 2px rgba(20,30,50,.08), 0 6px 14px rgba(20,30,50,.06);
}
.org-flag :global(svg) { width: 26px; height: 26px; flex-shrink: 0; }
.org-flag-logo { width: auto; padding: 0 .55rem; }
.org-flag :global(img) { height: 30px; width: auto; max-width: 64px; }
.org-id {
  position: relative; align-self: flex-start; margin-top: 1rem;
  font-size: .68rem; font-weight: 700; letter-spacing: .12em;
  padding: .25rem .65rem; border-radius: var(--radius-full);
  background: var(--c); color: #fff;
}
.org-card[style*="d9a727"] .org-id { color: var(--ink); }
.org-body { padding: 1.35rem 1.4rem 1.25rem; flex: 1; }
.org-body h3 { font-size: var(--fs-h3); color: var(--ink); margin-bottom: .3rem; }
.org-loc {
  display: flex; align-items: center; gap: .3rem;
  font-size: .82rem; color: var(--ink-mute); margin-bottom: .9rem;
}
.org-desc { font-size: .9rem; color: var(--ink-soft); line-height: 1.65; margin-bottom: 1.1rem; }
.org-tags { display: flex; flex-wrap: wrap; gap: .35rem; }
.org-tag {
  font-size: .72rem; font-weight: 500;
  padding: .2rem .65rem; border-radius: var(--radius-full);
  background: color-mix(in srgb, var(--c) 8%, white);
  color: color-mix(in srgb, var(--c) 72%, black);
  border: 1px solid color-mix(in srgb, var(--c) 22%, transparent);
}
.org-foot {
  padding: .95rem 1.4rem;
  border-top: 1px solid var(--line);
}
.org-link {
  font-size: .88rem; font-weight: 600; color: var(--c-text);
  text-decoration: none; transition: gap .2s var(--ease-out);
  display: inline-flex; align-items: center; gap: .35rem;
}
.org-link:hover { gap: .55rem; text-decoration: underline; text-underline-offset: 3px; }
.org-soon { font-size: .82rem; color: var(--ink-mute); }
.orgs-cta { text-align: center; }

@media (max-width: 960px) {
  .orgs-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .org-card, .org-card:nth-child(4) { grid-column: span 2; }
  .org-card:nth-child(5) { grid-column: 2 / span 2; }
}
@media (max-width: 620px) {
  .orgs-grid { grid-template-columns: 1fr; gap: 1.1rem; }
  .org-card, .org-card:nth-child(4), .org-card:nth-child(5) { grid-column: auto; }
}
</style>
