---
import BaseLayout from '../layouts/BaseLayout.astro';
import StarPieces from '../components/StarPieces.astro';
---

<BaseLayout
  title="Contacto · Únete o Colabora"
  description="Contacta con la Federación Estrellas de Europa. ¿Tu asociación quiere unirse o colaborar? Escríbenos: admin@estrellaseuropa.eu"
>

  <div class="page-hero" style="--ph-c: var(--logo-purple-l)">
    <StarPieces variant="outline" highlight={['purple']} class="ph-star" />
    <div class="container page-hero-content">
      <span class="badge badge-eu fade-in">Contacto</span>
      <h1 class="fade-in fade-in-delay-1">Hablemos</h1>
      <p class="fade-in fade-in-delay-2">
        ¿Tienes preguntas sobre la federación, quieres colaborar o tu asociación
        está interesada en unirse? Estamos aquí.
      </p>
    </div>
  </div>

  <section class="section contact-section">
    <div class="container">
      <div class="contact-grid">

        <div class="contact-info fade-in">
          <h2>Información de contacto</h2>
          <div class="info-cards">
            <div class="info-card">
              <div class="info-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <div>
                <h4>Email</h4>
                <a href="mailto:admin@estrellaseuropa.eu">admin<wbr />@estrellaseuropa.eu</a>
              </div>
            </div>

            <div class="info-card">
              <div class="info-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
              </div>
              <div>
                <h4>Sede social</h4>
                <p>San Valeriano 6, 4A<br />28039 Madrid, España</p>
              </div>
            </div>

            <div class="info-card">
              <div class="info-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <div>
                <h4>NIF</h4>
                <p>G75822320</p>
              </div>
            </div>
          </div>

        </div>

        <div class="orgs-contact fade-in fade-in-delay-1">
          <h2>Contacto por organización</h2>
          <ul class="org-contact-list">
              <li class="org-contact" style="--c: var(--c-sur); --c-text: var(--accent-text)">
                <span class="org-dot" aria-hidden="true"></span>
                <div>
                  <strong>Estrellas del Sur</strong>
                  <a href="mailto:admin@estrellasdelsur.eu">admin<wbr />@estrellasdelsur.eu</a>
                </div>
              </li>
              <li class="org-contact" style="--c: var(--c-magec); --c-text: var(--c-magec-ink)">
                <span class="org-dot" aria-hidden="true"></span>
                <div>
                  <strong>Estrella Magec</strong>
                  <a href="mailto:admin@estrellaseuropa.eu">admin<wbr />@estrellaseuropa.eu</a>
                </div>
              </li>
              <li class="org-contact" style="--c: var(--c-murcia); --c-text: var(--c-murcia)">
                <span class="org-dot" aria-hidden="true"></span>
                <div>
                  <strong>Murcia Debate</strong>
                  <a href="mailto:admin@estrellaseuropa.eu">admin<wbr />@estrellaseuropa.eu</a>
                </div>
              </li>
              <li class="org-contact" style="--c: var(--c-blue); --c-text: var(--c-blue)">
                <span class="org-dot" aria-hidden="true"></span>
                <div>
                  <strong>Estrella del Rif</strong>
                  <a href="mailto:asoc.estrelladelrif@gmail.com">asoc.estrelladelrif<wbr />@gmail.com</a>
                </div>
              </li>
              <li class="org-contact" style="--c: var(--c-rioja); --c-text: var(--c-rioja)">
                <span class="org-dot" aria-hidden="true"></span>
                <div>
                  <strong>Horizonte Rioja</strong>
                  <a href="mailto:horizonterioja@gmail.com">horizonterioja<wbr />@gmail.com</a>
                </div>
              </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
.contact-section { background: var(--sand); }
.contact-grid {
  display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: clamp(2.5rem, 5vw, 4rem); align-items: start;
}
.contact-info h2, .orgs-contact h2 {
  font-size: 1.6rem; color: var(--ink); margin-bottom: 1.5rem;
}
.info-cards { display: flex; flex-direction: column; gap: .85rem; }
.info-card {
  display: flex; align-items: flex-start; gap: 1rem;
  padding: 1.15rem 1.35rem;
  background: var(--parchment); border-radius: var(--radius-md);
  border: 1px solid var(--line); box-shadow: 0 1px 2px rgba(20,30,50,.04);
}
.info-icon {
  width: 44px; height: 44px; flex-shrink: 0;
  background: rgba(0,51,153,.08); border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  color: var(--eu-blue);
}
.info-card > div:last-child { min-width: 0; }
.info-card h4 {
  font-family: var(--font-sans); font-size: .72rem; font-weight: 700; text-transform: uppercase;
  letter-spacing: .12em; color: var(--ink-mute); margin-bottom: .2rem;
}
.info-card a, .info-card p { font-size: 1rem; color: var(--ink); line-height: 1.55; text-decoration: none; overflow-wrap: break-word; }
.info-card a { font-weight: 600; color: var(--eu-blue); }
.info-card a:hover { text-decoration: underline; text-underline-offset: 3px; }
.org-contact-list { display: flex; flex-direction: column; gap: .85rem; }
.org-contact {
  position: relative; overflow: hidden;
  display: flex; align-items: center; gap: .9rem;
  padding: 1rem 1.25rem 1rem 1.4rem; border-radius: var(--radius-md);
  background: var(--parchment); border: 1px solid var(--line);
}
.org-contact::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--c); }
.org-contact > div { min-width: 0; }
.org-dot {
  width: 12px; height: 12px; flex-shrink: 0; background: var(--c);
  clip-path: polygon(0 100%, 100% 0, 62% 100%);
}
.org-contact strong { display: block; font-size: .98rem; color: var(--ink); margin-bottom: .05rem; }
.org-contact a {
  display: inline-block; padding: .2rem 0;
  font-size: .9rem; font-weight: 500; color: var(--c-text); text-decoration: none; overflow-wrap: break-word;
}
.org-contact a:hover { text-decoration: underline; text-underline-offset: 3px; }

@media (max-width: 860px) {
  .contact-grid { grid-template-columns: 1fr; }
}
</style>
