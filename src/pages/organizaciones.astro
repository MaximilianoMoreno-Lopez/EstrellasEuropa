---
import BaseLayout from '../layouts/BaseLayout.astro';
import StarPieces from '../components/StarPieces.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const ICON = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"';
const orgs = [
  {
    id: 'eds',
    name: 'Estrellas del Sur',
    location: 'Córdoba, Andalucía',
    founded: '2020',
    color: 'var(--c-sur)',
    colorRgb: '31,79,168',
    flag: `<img class="sq" src="${base}/orgs/estrellas-del-sur.png" alt="" width="256" height="256" />`,
    description:
      'Asociación juvenil con sede en Córdoba que lleva desde 2019 promoviendo la movilidad europea entre jóvenes del sur de España. Fue la impulsora de la creación de la Federación Estrellas de Europa en 2024.',
    activities: [
      'Intercambios juveniles Erasmus+',
      'Voluntariado del Cuerpo Europeo de Solidaridad (ESC)',
      'Formaciones de líderes juveniles',
      'Proyectos de participación ciudadana',
    ],
    website: 'https://estrellasdelsur.eu',
    email: 'admin@estrellasdelsur.eu',
  },
  {
    id: 'ema',
    name: 'Estrella Magec',
    location: 'Islas Canarias',
    founded: '2022',
    color: 'var(--c-magec)',
    colorRgb: '217,167,39',
    flag: `<img class="sq" src="${base}/orgs/estrella-magec.png" alt="" width="256" height="256" />`,
    description:
      'Organización canaria que trabaja por la inclusión y la participación activa de jóvenes en proyectos europeos, con especial atención a colectivos con menos oportunidades.',
    activities: [
      'Inclusión juvenil',
      'Proyectos Erasmus+ KA1 y KA2',
      'Educación no formal',
      'Cooperación internacional',
    ],
    website: null,
    email: 'admin@estrellaseuropa.eu',
  },
  {
    id: 'mur',
    name: 'Murcia Debate',
    location: 'Murcia',
    founded: '2021',
    color: 'var(--c-murcia)',
    colorRgb: '107,58,138',
    flag: `<svg ${ICON}><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0"/><line x1="12" y1="17" x2="12" y2="22"/></svg>`,
    description:
      'Asociación murciana que utiliza el debate y la argumentación como herramientas de educación no formal para desarrollar el pensamiento crítico y la participación cívica entre jóvenes.',
    activities: [
      'Torneos de debate',
      'Formación en oratoria',
      'Proyectos europeos de participación',
      'Ciudadanía activa',
    ],
    website: null,
    email: 'admin@estrellaseuropa.eu',
  },
  {
    id: 'edr',
    name: 'Estrella del Rif',
    location: 'Melilla',
    founded: '2024',
    color: 'var(--c-rif)',
    colorRgb: '47,125,66',
    flag: `<img class="sq" src="${base}/orgs/estrella-del-rif.svg" alt="" width="256" height="256" />`,
    description:
      'Asociación juvenil de Melilla, formada íntegramente por voluntariado. Trabaja con educación no formal para que la juventud de una ciudad sin conexión terrestre con Europa continental participe en la vida democrática y acceda a las oportunidades europeas, con un enfoque intercultural que refleja la diversidad de la ciudad.',
    activities: [
      'Diálogo intercultural y cohesión comunitaria',
      'Participación democrática y ciudadanía europea',
      'Inclusión de jóvenes con discapacidad',
      'Pensamiento crítico y alfabetización mediática',
    ],
    website: 'https://estrelladelrif.eu',
    email: 'asoc.estrelladelrif@gmail.com',
  },
  {
    id: 'hri',
    name: 'Horizonte Rioja',
    location: 'La Rioja',
    founded: '2025',
    color: 'var(--c-rioja)',
    colorRgb: '184,58,68',
    flag: `<img src="${base}/orgs/horizonte-rioja.svg" alt="" width="260" height="168" />`,
    description:
      'Asociación juvenil fundada a finales de 2025 por jóvenes con raíces en los pueblos de La Rioja. Trabaja para que la juventud del medio rural, sobre todo la de zonas despobladas o con menos recursos, tenga acceso a información, formación y experiencias europeas, con especial atención a la igualdad de género y a la diversidad LGTBIQ+. Coordina Rural Identities, su primer proyecto Erasmus+.',
    activities: [
      'Talleres y charlas en los pueblos',
      'Espacios seguros de diálogo para jóvenes',
      'Movilidad europea para la juventud rural',
      'Rural Identities, asociación a pequeña escala Erasmus+ (KA210)',
    ],
    website: 'https://www.horizonterioja.eu',
    email: 'horizonterioja@gmail.com',
  },
];
---

<BaseLayout
  title="Organizaciones Miembro · Asociaciones Juveniles"
  description="Descubre las asociaciones juveniles que forman la Federación Estrellas de Europa: Estrellas del Sur (Córdoba), Estrella Magec (Canarias), Murcia Debate (Murcia), Estrella del Rif (Melilla) y Horizonte Rioja (La Rioja)."
>

  <div class="page-hero">
    <StarPieces variant="outline" highlight={['all']} class="ph-star" />
    <div class="container page-hero-content">
      <span class="badge badge-eu fade-in">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.4H22l-6.2 4.5 2.4 7.4L12 17l-6.2 4.3 2.4-7.4L2 9.4h7.6z"/></svg>
        Organizaciones miembro
      </span>
      <h1 class="fade-in fade-in-delay-1">Las asociaciones que forman la federación</h1>
      <p class="fade-in fade-in-delay-2">
        Cinco entidades de distintas regiones de España, unidas por el compromiso con
        la juventud y los valores europeos.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="orgs-list">
        {orgs.map((org, i) => (
          <article id={org.id} class={`org-detail fade-in ${org.id === 'ema' ? 'org-light' : ''}`} style={`--org-color: ${org.color}; --org-rgb: ${org.colorRgb}; --org-text: ${org.id === 'ema' ? 'var(--c-magec-ink)' : org.color}`}>
            <div class="org-detail-side">
              <div class={`org-detail-flag ${org.id === 'hri' ? 'org-detail-logo' : ''}`} set:html={org.flag} />
              <span class="org-detail-badge">{org.id.toUpperCase()}</span>
              <p class="org-detail-founded">Fundada en {org.founded}</p>
              <p class="org-detail-loc">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
                {org.location}
              </p>
              {org.website && (
                <a href={org.website} target="_blank" rel="noopener" class="org-detail-link">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M8 7h9v9"/></svg>
                  Visitar web<span class="sr-only"> (se abre en otra pestaña)</span>
                </a>
              )}
              {org.email && (
                <a href={`mailto:${org.email}`} class="org-detail-link">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
                  <span>{org.email.split('@')[0]}<wbr />@{org.email.split('@')[1]}</span>
                </a>
              )}
            </div>

            <div class="org-detail-main">
              <h2 class="org-detail-name">{org.name}</h2>
              <p class="org-detail-desc">{org.description}</p>

              <h3 class="org-detail-activities-title">Actividades principales</h3>
              <ul class="org-detail-activities">
                {org.activities.map(act => (
                  <li>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    {act}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="join-section section-sm">
    <div class="container join-inner">
      <div class="join-text fade-in">
        <h2>¿Tu asociación quiere ser miembro?</h2>
        <p>
          La federación está abierta a nuevas organizaciones que trabajen con jóvenes
          y compartan los valores de movilidad, inclusión y aprendizaje no formal.
        </p>
      </div>
      <a href={`${base}/unete/`} class="btn btn-primary btn-lg fade-in fade-in-delay-1">
        Quiero ser miembro
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

</BaseLayout>

<style>
.orgs-list { display: flex; flex-direction: column; gap: 2rem; }
.org-detail {
  display: grid; grid-template-columns: 260px minmax(0, 1fr);
  background: var(--parchment);
  border-radius: var(--radius-lg);
  border: 1px solid rgba(20,30,50,.07);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  scroll-margin-top: 92px;
  position: relative;
}
.org-detail::before {
  content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--org-color);
}
.org-detail:target { box-shadow: 0 0 0 2px var(--org-color), var(--shadow-lg); }
.org-detail-side {
  background: linear-gradient(180deg, rgba(var(--org-rgb),.09) 0%, rgba(var(--org-rgb),.03) 100%);
  padding: 2rem 1.6rem 2rem 1.85rem;
  border-right: 1px solid rgba(20,30,50,.06);
  display: flex; flex-direction: column; gap: .6rem; align-items: flex-start;
}
.org-detail-flag {
  display: flex; align-items: center; justify-content: center;
  width: 64px; height: 64px; border-radius: 16px; margin-bottom: .6rem;
  background: var(--parchment); color: var(--org-text);
  box-shadow: 0 1px 2px rgba(20,30,50,.08), 0 8px 18px rgba(20,30,50,.07);
}
.org-detail-flag :global(svg) { width: 30px; height: 30px; flex-shrink: 0; }
.org-detail-logo { width: auto; padding: 0 .75rem; }
.org-detail-flag :global(img) { height: 38px; width: auto; max-width: 80px; }
.org-detail-flag :global(img.sq) { height: 52px; width: 52px; }
@media (max-width: 760px) { .org-detail-flag :global(img.sq) { height: 46px; width: 46px; } }
.org-detail-badge {
  display: inline-block; padding: .25rem .8rem;
  border-radius: var(--radius-full);
  background: var(--org-color); color: #fff;
  font-size: .7rem; font-weight: 700; letter-spacing: .12em;
}
.org-light .org-detail-badge { color: var(--ink); }
.org-detail-founded { font-size: .84rem; color: var(--ink-mute); font-variant-numeric: lining-nums; }
.org-detail-loc {
  display: flex; align-items: center; gap: .35rem;
  font-size: .88rem; color: var(--ink-soft); font-weight: 500;
}
.org-detail-link {
  display: inline-flex; align-items: center; gap: .45rem; max-width: 100%;
  font-size: .86rem; color: var(--org-text);
  font-weight: 600; text-decoration: none; padding: .15rem 0;
  min-width: 0; overflow-wrap: break-word; min-height: 32px;
}
.org-detail-link svg { flex-shrink: 0; }
.org-detail-link:first-of-type { margin-top: .5rem; }
.org-detail-link:hover { text-decoration: underline; text-underline-offset: 3px; }
.org-detail-main { padding: 2.25rem 2.5rem; }
.org-detail-name { font-size: clamp(1.5rem, 2.4vw, 1.875rem); color: var(--ink); margin-bottom: .85rem; }
.org-detail-desc { color: var(--ink-soft); line-height: 1.75; margin-bottom: 1.75rem; font-size: 1.02rem; max-width: 68ch; }
.org-detail-activities-title {
  font-family: var(--font-sans);
  font-size: .74rem; font-weight: 700; letter-spacing: .12em;
  text-transform: uppercase; color: var(--ink-mute); margin-bottom: .9rem;
}
.org-detail-activities { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem 1.5rem; }
.org-detail-activities li {
  display: flex; align-items: flex-start; gap: .55rem;
  font-size: .93rem; color: var(--ink-soft); line-height: 1.5;
}
.org-detail-activities svg {
  color: var(--org-text); flex-shrink: 0; margin-top: .1rem;
  padding: 2px; border-radius: 50%; background: rgba(var(--org-rgb), .12);
  width: 18px; height: 18px;
}

.join-section { background: var(--parchment); border-top: 1px solid var(--line); }
.join-inner {
  display: flex; align-items: center; justify-content: space-between;
  gap: 1.5rem 2rem; flex-wrap: wrap;
}
.join-text h2 { font-size: clamp(1.5rem, 2.6vw, 1.9rem); color: var(--ink); margin-bottom: .5rem; }
.join-text p { color: var(--ink-soft); max-width: 52ch; }

@media (max-width: 860px) {
  .org-detail-activities { grid-template-columns: 1fr; }
}
@media (max-width: 720px) {
  .org-detail { grid-template-columns: minmax(0, 1fr); }
  .org-detail-side {
    border-right: none; border-bottom: 1px solid rgba(20,30,50,.06);
    display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 1rem; row-gap: .35rem;
    padding: 1.5rem 1.35rem 1.35rem 1.6rem;
  }
  .org-detail-flag { grid-row: span 3; margin-bottom: 0; width: 56px; height: 56px; }
  .org-detail-logo { width: auto; }
  .org-detail-side > * { justify-self: start; }
  .org-detail-link { grid-column: 1 / -1; }
  .org-detail-link:first-of-type { margin-top: .4rem; }
  .org-detail-main { padding: 1.5rem 1.35rem 1.6rem 1.6rem; }
}
</style>
