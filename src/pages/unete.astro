---
import BaseLayout from '../layouts/BaseLayout.astro';
import StarPieces from '../components/StarPieces.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const ICON = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"';
const beneficios = [
  { icon: `<svg ${ICON}><circle cx="12" cy="12" r="9"/><path d="M15 9.3a3.8 3.8 0 1 0 0 5.4"/><path d="M6.5 11h6M6.5 13.3h5"/></svg>`, title: 'Financiación conjunta', desc: 'Acceso a candidaturas Erasmus+ y CES presentadas en red, con más opciones de ser aprobadas.' },
  { icon: `<svg ${ICON}><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>`, title: 'Red de organizaciones', desc: 'Conexión con entidades juveniles de toda España y con socios europeos de confianza.' },
  { icon: `<svg ${ICON}><path d="M4 5a2 2 0 0 1 2-2h6v16H6a2 2 0 0 0-2 2z"/><path d="M20 5a2 2 0 0 0-2-2h-6v16h6a2 2 0 0 1 2 2z"/></svg>`, title: 'Metodologías compartidas', desc: 'Intercambio de buenas prácticas, plantillas y aprendizajes entre organizaciones miembro.' },
  { icon: `<svg ${ICON}><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/></svg>`, title: 'Formación', desc: 'Acceso a movilidades de formación (KA153) para vuestro equipo de trabajadores de juventud.' },
  { icon: `<svg ${ICON}><path d="M3 11l14-6v14L3 13z"/><path d="M7 13.5V17a2 2 0 0 0 4 0v-1.5"/></svg>`, title: 'Visibilidad', desc: 'Presencia en la web de la federación y difusión conjunta de vuestros proyectos.' },
  { icon: `<svg ${ICON}><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z"/></svg>`, title: 'Dimensión europea', desc: 'Mayor alcance e impacto para vuestras iniciativas locales dentro del proyecto europeo.' },
];

const requisitos = [
  'Ser una asociación juvenil sin ánimo de lucro legalmente constituida.',
  'Trabajar con personas jóvenes en vuestro territorio.',
  'Compartir los valores europeos: inclusión, participación y aprendizaje no formal.',
  'Tener voluntad de cooperar y aportar a una red común.',
];

const pasos = [
  { n: '1', title: 'Primer contacto', desc: 'Nos escribes y nos cuentas quiénes sois y qué hacéis.' },
  { n: '2', title: 'Nos conocemos', desc: 'Una conversación para ver encaje de valores, objetivos y formas de trabajo.' },
  { n: '3', title: 'Propuesta de adhesión', desc: 'Preparamos juntos la documentación necesaria para la incorporación.' },
  { n: '4', title: 'Aprobación', desc: 'La Asamblea General ratifica la adhesión y damos la bienvenida a la nueva organización.' },
];
---

<BaseLayout
  title="Únete a la federación"
  description="¿Tu asociación juvenil quiere formar parte de Estrellas de Europa? Descubre los beneficios, requisitos y el proceso de adhesión a la federación."
>
  <div class="page-hero" style="--ph-c: var(--logo-green-l)">
    <StarPieces variant="outline" highlight={['green']} class="ph-star" />
    <div class="container page-hero-content">
      <span class="badge badge-eu fade-in">Adhesión</span>
      <h1 class="fade-in fade-in-delay-1">Súmate a Estrellas de Europa</h1>
      <p class="fade-in fade-in-delay-2">
        Si tu asociación trabaja con jóvenes y cree en el proyecto europeo,
        juntos podemos llegar más lejos.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="center-head fade-in">
        <span class="section-label" style="--label-c: var(--c-rioja)">Por qué unirse</span>
        <h2 class="section-title">Lo que ganáis al formar parte</h2>
        <div class="divider"></div>
      </div>
      <div class="benefits-grid">
        {beneficios.map((b, i) => (
          <div class={`benefit-card fade-in fade-in-delay-${(i % 3) + 1}`} style={`--bc: ${['var(--c-sur)', 'var(--c-magec-ink)', 'var(--c-murcia)', 'var(--c-blue)', 'var(--c-rioja)', 'var(--eu-blue)'][i % 6]}`}>
            <span class="benefit-icon" set:html={b.icon} />
            <h3>{b.title}</h3>
            <p>{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section req-section">
    <div class="container req-grid">
      <div class="fade-in">
        <span class="section-label" style="--label-c: var(--c-green)">Requisitos</span>
        <h2 class="section-title">¿Encajáis en la federación?</h2>
        <div class="divider"></div>
        <ul class="req-list">
          {requisitos.map((r) => (
            <li>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              {r}
            </li>
          ))}
        </ul>
      </div>
      <div class="steps fade-in fade-in-delay-1">
        <h3 class="steps-title">El proceso, paso a paso</h3>
        {pasos.map((p) => (
          <div class="step">
            <span class="step-n">{p.n}</span>
            <div>
              <strong>{p.title}</strong>
              <p>{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="unete-cta cta-band">
    <div class="container cta-inner fade-in">
      <h2>¿Damos el primer paso?</h2>
      <p>Escríbenos y empezamos a hablar. Sin compromiso.</p>
      <a href="mailto:admin@estrellaseuropa.eu?subject=Adhesión a Estrellas de Europa" class="btn btn-amber btn-lg">
        Escribir a la federación
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .center-head { max-width: 640px; margin-bottom: var(--space-head); }
  .benefits-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .benefit-card {
    position: relative; overflow: hidden;
    background: var(--parchment); border: 1px solid rgba(20,30,50,.08);
    border-radius: var(--radius-lg); padding: 1.85rem 1.75rem;
    box-shadow: var(--shadow-card);
  }
  .benefit-card::before {
    content: ''; position: absolute; top: 0; left: 1.75rem; width: 40px; height: 3px; background: var(--bc);
    border-radius: 0 0 2px 2px;
  }
  .benefit-icon {
    width: 48px; height: 48px; margin-bottom: 1.15rem;
    border-radius: 12px; display: flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--bc) 11%, transparent); color: var(--bc);
  }
  .benefit-icon :global(svg) { width: 23px; height: 23px; flex-shrink: 0; }
  .benefit-card h3 { font-size: 1.0625rem; color: var(--ink); margin-bottom: .45rem; font-family: var(--font-sans); font-weight: 600; letter-spacing: 0; }
  .benefit-card p { font-size: .9rem; color: var(--ink-soft); line-height: 1.65; }

  .req-section { background: var(--parchment); }
  .req-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2.5rem, 6vw, 5rem); align-items: start; }
  .req-list { display: flex; flex-direction: column; gap: .9rem; margin-top: .5rem; }
  .req-list li { display: flex; align-items: flex-start; gap: .7rem; font-size: 1.02rem; color: var(--ink-soft); line-height: 1.55; }
  .req-list svg {
    color: var(--c-green); flex-shrink: 0; margin-top: .1rem;
    width: 22px; height: 22px; padding: 3px; border-radius: 50%; background: rgba(61,120,72,.12);
  }

  .steps {
    background: var(--sand); border: 1px solid var(--sand-dark); border-radius: var(--radius-lg);
    padding: 2rem 2rem .5rem;
  }
  .steps-title {
    font-family: var(--font-sans); font-size: .74rem; font-weight: 700;
    letter-spacing: .14em; text-transform: uppercase; color: var(--ink-mute); margin-bottom: 1.5rem;
  }
  .step { display: flex; gap: 1rem; padding-bottom: 1.5rem; position: relative; }
  .step:not(:last-child)::after {
    content: ''; position: absolute; left: 17px; top: 40px; bottom: 6px;
    width: 2px; background: var(--sand-deeper);
  }
  .step-n {
    width: 36px; height: 36px; flex-shrink: 0; border-radius: 50%;
    background: var(--parchment); color: var(--accent-text); border: 2px solid var(--accent);
    font-family: var(--font-serif); font-weight: 700; font-size: 1rem; font-variant-numeric: lining-nums;
    display: flex; align-items: center; justify-content: center; z-index: 1;
  }
  .step:last-child .step-n { background: var(--accent); color: #fff; }
  .step strong { display: block; color: var(--ink); margin-bottom: .2rem; font-size: 1.02rem; }
  .step p { font-size: .9rem; color: var(--ink-soft); line-height: 1.6; }

  .unete-cta { padding: clamp(3.5rem, 7vw, 5rem) 0; text-align: center; }
  .unete-cta .cta-inner { max-width: 600px; margin: 0 auto; }
  .unete-cta h2 { color: #fff; font-size: clamp(1.75rem, 3.2vw, 2.4rem); margin-bottom: .6rem; }
  .unete-cta p { color: rgba(255,255,255,.8); margin-bottom: 1.75rem; font-size: 1.05rem; }

  @media (max-width: 860px) {
    .benefits-grid { grid-template-columns: 1fr 1fr; }
    .req-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .benefits-grid { grid-template-columns: 1fr; gap: 1rem; }
    .steps { padding: 1.5rem 1.25rem .25rem; }
    .unete-cta .btn { width: 100%; white-space: normal; }
  }
</style>
