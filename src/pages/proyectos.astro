---
import BaseLayout from '../layouts/BaseLayout.astro';
import StarPieces from '../components/StarPieces.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const ICON = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"';
const proyectos = [
  {
    badge: 'Erasmus+ KA152',
    accent: 'var(--c-murcia)',
    title: 'Frames of Us',
    status: 'En preparación',
    statusColor: 'var(--c-magec-ink)',
    icon: `<svg ${ICON}><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>`,
    lead: 'Intercambio juvenil de ocho días en Madrid coordinado por la federación, con cinco organizaciones de Chequia, Portugal, Chipre, Polonia y Grecia. Treinta jóvenes trabajan bienestar, identidad y participación a través de la narración.',
    points: [
      '30 jóvenes de seis países, con prioridad para quienes tienen menos oportunidades.',
      'Fotovoz, teatro silencioso, relato digital y cine social: 48 horas de educación no formal.',
      'Día Comunitario abierto al barrio de Usera, conducido por las propias personas participantes.',
      'Reconocimiento con Youthpass y certificación de Red Reconoce.',
    ],
    tags: ['Intercambio juvenil', 'Bienestar', 'Narración', 'Madrid'],
    href: `${base}/proyectos/frames-of-us/`,
    hrefLabel: 'Ver la ficha del proyecto',
  },
  {
    badge: 'Cuerpo Europeo de Solidaridad',
    accent: 'var(--c-green)',
    title: 'Decide con Información',
    status: 'En ejecución',
    statusColor: 'var(--c-green)',
    icon: `<svg ${ICON}><path d="M12 3 2 8l10 5 10-5-10-5Z"/><path d="M6 10.5V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-5.5"/><path d="M22 8v6"/></svg>`,
    lead: 'Proyecto de Solidaridad (ESC30-SOL) concedido a la federación: cinco jóvenes acompañan a estudiantes de institutos públicos madrileños en la elección de itinerarios internacionales de Bachillerato.',
    points: [
      'Sesiones en aula sobre Bachibac, Bachillerato Dual e IB, con orientación entre iguales.',
      'Tutorías individuales y acompañamiento en la solicitud real.',
      'Materiales abiertos que quedan en el centro para los cursos siguientes.',
    ],
    tags: ['Inclusión y diversidad', 'Orientación académica', 'Comunidad de Madrid'],
    href: `${base}/proyectos/decide-con-informacion/`,
    hrefLabel: 'Ver seguimiento del proyecto',
  },
  {
    badge: 'Erasmus+ KA153',
    accent: 'var(--eu-blue)',
    title: 'NEST',
    status: 'Activo',
    statusColor: 'var(--c-green)',
    icon: `<svg ${ICON}><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>`,
    lead: 'NEST es el proyecto de movilidad de trabajadores de juventud (Erasmus+ KA153) concedido a la federación: financia estancias formativas de nuestros educadores y técnicos en organizaciones de acogida europeas.',
    points: [
      'Estancias formativas para youth workers en organizaciones de acogida europeas.',
      'Transferencia de buenas prácticas y metodologías de educación no formal.',
      'Trabajo en red con organizaciones juveniles de varios países.',
      'Mejora directa de la calidad de los proyectos que después realizamos en España.',
    ],
    tags: ['Movilidad internacional', 'Formación', 'Trabajadores de juventud', 'Educación no formal'],
    href: `${base}/actualidad/nest-cooperacion-europea/`,
    hrefLabel: 'Leer en actualidad',
  },
  {
    badge: 'Erasmus+ KA153',
    accent: 'var(--c-blue)',
    title: '2Fast2Innovative',
    status: 'Convocatoria abierta',
    statusColor: 'var(--c-magec-ink)',
    icon: `<svg ${ICON}><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7V18h8v-3.3A7 7 0 0 0 12 2Z"/></svg>`,
    lead: 'Curso de formación sobre emprendimiento social e innovación rural en Trancoso, en el interior de Portugal, coordinado por Hawk Stars. La federación es la organización socia española y envía al equipo nacional, que viaja del 26 de octubre al 3 de noviembre de 2026.',
    points: [
      '21 trabajadores juveniles de siete países, tres de ellos enviados desde España.',
      'Herramientas de emprendimiento social, innovación rural, facilitación y trabajo juvenil digital para acompañar a jóvenes de entornos rurales.',
      'Co-creación de seis actividades de educación no formal, probadas con estudiantes del instituto de Pinhel, que formarán un toolkit abierto.',
      'Youthpass para las 21 personas participantes y un seminario de difusión en cada país socio.',
    ],
    tags: ['Emprendimiento social', 'Innovación rural', 'Formación', 'Portugal'],
    href: `${base}/proyectos/2fast2innovative/`,
    hrefLabel: 'Ver la convocatoria',
  },
];

const acciones = [
  { code: 'KA1', name: 'Movilidad de las personas', desc: 'Intercambios juveniles, movilidad de trabajadores de juventud (KA151/KA153) y actividades de participación.' },
  { code: 'KA2', name: 'Cooperación entre organizaciones', desc: 'Asociaciones de cooperación (KA210/KA220) para crear e intercambiar prácticas innovadoras entre entidades europeas.' },
  { code: 'CES', name: 'Cuerpo Europeo de Solidaridad', desc: 'Voluntariado y proyectos de solidaridad que permiten a la juventud contribuir en su comunidad y en Europa.' },
];
---

<BaseLayout
  title="Proyectos"
  description="Proyectos europeos de la Federación Estrellas de Europa: NEST (movilidad Erasmus+ KA153), 2Fast2Innovative (formación en emprendimiento social en Portugal) y Decide con Información, proyecto del Cuerpo Europeo de Solidaridad."
>
  <div class="page-hero" style="--ph-c: var(--logo-blue-l)">
    <StarPieces variant="outline" highlight={['blue']} class="ph-star" />
    <div class="container page-hero-content">
      <span class="badge badge-eu fade-in">Proyectos europeos</span>
      <h1 class="fade-in fade-in-delay-1">Lo que estamos construyendo</h1>
      <p class="fade-in fade-in-delay-2">
        Proyectos con impacto real para jóvenes y educadores de toda España,
        financiados por el programa Erasmus+ de la Unión Europea.
      </p>
    </div>
  </div>

  <section class="section">
    <div class="container proyectos-list">
      {proyectos.map((p) => (
        <article class="proyecto fade-in" style={`--ac: ${p.accent}`}>
          <div class="proyecto-side">
            <span class="proyecto-icon" set:html={p.icon} />
            <span class="proyecto-badge">{p.badge}</span>
            <span class="proyecto-status" style={`color:${p.statusColor}`}>
              <span class="status-dot" style={`background:${p.statusColor}`}></span>{p.status}
            </span>
          </div>
          <div class="proyecto-main">
            <h2>{p.title}</h2>
            <p class="proyecto-lead">{p.lead}</p>
            <ul class="proyecto-points">
              {p.points.map((pt) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                  {pt}
                </li>
              ))}
            </ul>
            <div class="proyecto-tags">
              {p.tags.map((t) => <span class="proyecto-tag">{t}</span>)}
            </div>
            {p.href && (
              <a
                href={p.href}
                class="proyecto-link"
                target={p.external ? '_blank' : undefined}
                rel={p.external ? 'noopener' : undefined}
              >
                {p.hrefLabel ?? 'Ver más'}
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section acciones-section">
    <div class="container">
      <div class="acciones-header fade-in">
        <span class="section-label" style="--label-c: var(--c-blue)">El programa Erasmus+</span>
        <h2 class="section-title">Cómo financia Europa el trabajo juvenil</h2>
        <p class="section-subtitle">
          Nuestros proyectos se enmarcan en las distintas acciones del programa Erasmus+
          y del Cuerpo Europeo de Solidaridad.
        </p>
      </div>
      <div class="acciones-grid">
        {acciones.map((a, i) => (
          <div class={`accion-card fade-in fade-in-delay-${i + 1}`}>
            <span class="accion-code">{a.code}</span>
            <h3>{a.name}</h3>
            <p>{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="proyectos-cta cta-band">
    <div class="container cta-inner">
      <div class="fade-in">
        <h2>¿Quieres participar en un proyecto?</h2>
        <p>Sigue nuestra actualidad o escríbenos para conocer las próximas convocatorias.</p>
      </div>
      <div class="cta-actions fade-in fade-in-delay-1">
        <a href={`${base}/actualidad/`} class="btn btn-amber btn-lg">Ver actualidad</a>
        <a href={`${base}/contacto/`} class="btn btn-outline-white btn-lg">Contactar</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .proyectos-list { display: flex; flex-direction: column; gap: 2rem; }
  .proyecto {
    position: relative;
    display: grid; grid-template-columns: 250px minmax(0, 1fr);
    background: var(--parchment);
    border: 1px solid rgba(20,30,50,.08);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .proyecto::before {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--ac);
  }
  .proyecto-side {
    background: color-mix(in srgb, var(--ac) 7%, var(--parchment));
    border-right: 1px solid rgba(20,30,50,.06);
    padding: 2rem 1.6rem 2rem 1.85rem;
    display: flex; flex-direction: column; gap: .85rem; align-items: flex-start;
  }
  .proyecto-icon {
    width: 60px; height: 60px; border-radius: 16px;
    display: flex; align-items: center; justify-content: center;
    color: var(--ac); background: var(--parchment);
    box-shadow: 0 1px 2px rgba(20,30,50,.08), 0 8px 18px rgba(20,30,50,.07);
    margin-bottom: .25rem;
  }
  .proyecto-icon :global(svg) { width: 28px; height: 28px; flex-shrink: 0; }
  .proyecto-badge {
    font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    color: #fff; background: var(--ac); padding: .3rem .8rem; border-radius: var(--radius-full);
    max-width: 100%; white-space: normal; line-height: 1.35;
  }
  .proyecto-status { display: flex; align-items: center; gap: .45rem; font-size: .84rem; font-weight: 600; }
  .status-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
  .proyecto-main { padding: 2.25rem 2.5rem; }
  .proyecto-main h2 { font-size: clamp(1.5rem, 2.4vw, 1.875rem); color: var(--ink); margin-bottom: .7rem; }
  .proyecto-lead { color: var(--ink-soft); line-height: 1.75; margin-bottom: 1.4rem; font-size: 1.02rem; max-width: 70ch; }
  .proyecto-points { display: flex; flex-direction: column; gap: .6rem; margin-bottom: 1.4rem; }
  .proyecto-points li {
    display: flex; align-items: flex-start; gap: .6rem;
    font-size: .93rem; color: var(--ink-soft); line-height: 1.55;
  }
  .proyecto-points svg {
    color: var(--ac); flex-shrink: 0; margin-top: .12rem;
    width: 18px; height: 18px; padding: 2px; border-radius: 50%;
    background: color-mix(in srgb, var(--ac) 12%, transparent);
  }
  .proyecto-tags { display: flex; flex-wrap: wrap; gap: .4rem; }
  .proyecto-link {
    display: inline-flex; align-items: center; gap: .45rem; margin-top: 1.5rem;
    font-size: .92rem; font-weight: 600; color: var(--ac); text-decoration: none;
    transition: gap .2s var(--ease-out); min-height: 44px;
  }
  .proyecto-link:hover { gap: .7rem; }
  .proyecto-tag {
    font-size: .72rem; font-weight: 500; padding: .25rem .7rem;
    border-radius: var(--radius-full); background: var(--sand);
    color: var(--ink-soft); border: 1px solid var(--sand-dark);
  }

  .acciones-section { background: var(--parchment); }
  .acciones-header { max-width: 640px; margin-bottom: var(--space-head); }
  .acciones-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .accion-card {
    position: relative; overflow: hidden;
    background: var(--sand); border: 1px solid var(--sand-dark);
    border-radius: var(--radius-lg); padding: 1.85rem 1.75rem;
  }
  .accion-code {
    display: inline-block; font-family: var(--font-serif);
    font-size: 2.25rem; font-weight: 600; color: var(--eu-blue); margin-bottom: .6rem; line-height: 1;
    font-variant-numeric: lining-nums;
  }
  .accion-card h3 { font-size: 1.0625rem; color: var(--ink); margin-bottom: .45rem; font-family: var(--font-sans); font-weight: 600; }
  .accion-card p { font-size: .9rem; color: var(--ink-soft); line-height: 1.65; }

  .proyectos-cta { padding: clamp(3.5rem, 6vw, 4.75rem) 0; }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 1.75rem 2.5rem; flex-wrap: wrap; }
  .cta-inner h2 { color: #fff; font-size: clamp(1.6rem, 2.8vw, 2.1rem); margin-bottom: .5rem; }
  .cta-inner p { color: rgba(255,255,255,.78); max-width: 46ch; }
  .cta-actions { display: flex; gap: .85rem; flex-wrap: wrap; }

  @media (max-width: 860px) {
    .acciones-grid { grid-template-columns: 1fr; gap: 1rem; }
  }
  @media (max-width: 760px) {
    .proyecto { grid-template-columns: minmax(0, 1fr); }
    .proyecto-side {
      flex-direction: row; align-items: center; flex-wrap: wrap; gap: .6rem .75rem;
      border-right: none; border-bottom: 1px solid rgba(20,30,50,.06);
      padding: 1.35rem 1.35rem 1.25rem 1.6rem;
    }
    .proyecto-icon { width: 48px; height: 48px; border-radius: 12px; margin: 0 .25rem 0 0; }
    .proyecto-icon :global(svg) { width: 24px; height: 24px; }
    .proyecto-main { padding: 1.5rem 1.35rem 1.6rem 1.6rem; }
  }
  @media (max-width: 560px) {
    .cta-actions { flex-direction: column; align-items: stretch; width: 100%; }
  }
</style>
